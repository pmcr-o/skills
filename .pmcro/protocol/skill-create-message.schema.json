{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pmcro.dev/protocol/skill-create-message.schema.json",
  "title": "PMCR-O skill.create.request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion", "kind", "requestId", "trailId", "cycleId", "sourceIntent",
    "plugin", "skill", "description", "purpose", "scope", "validatedResources",
    "requiredFolders", "requiredFiles", "optionalFolders", "messageContract", "mode",
    "candidateState", "registrationRequiredBeforeUse"
  ],
  "properties": {
    "apiVersion": {"const": "pmcro.dev/v1"},
    "kind": {"const": "skill.create.request"},
    "requestId": {"type": "string", "minLength": 1},
    "trailId": {"type": "string", "minLength": 1},
    "cycleId": {"type": "string", "minLength": 1},
    "sourceIntent": {"type": "string", "minLength": 1},
    "plugin": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "skill": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "description": {"type": "string", "minLength": 1, "maxLength": 1024},
    "purpose": {"type": "string", "minLength": 1},
    "scope": {"enum": ["global", "personal", "project", "run"]},
    "validatedResources": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "requiredFolders": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "contains": {"const": "agents"},
      "items": {"enum": ["agents"]}
    },
    "requiredFiles": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "contains": {"const": "SKILL.md"},
      "items": {"enum": ["SKILL.md"]}
    },
    "optionalFolders": {
      "type": "array", "uniqueItems": true,
      "items": {"enum": ["references", "assets", "scripts", "tests"]}
    },
    "samplePromptsRef": {"type": ["string", "null"]},
    "messageContract": {
      "type": "object",
      "required": ["input", "output", "accept", "deny"],
      "properties": {
        "input": {"type": "array", "minItems": 1},
        "output": {"type": "array", "minItems": 1},
        "accept": {"type": "array", "minItems": 1},
        "deny": {"type": "array", "minItems": 1}
      },
      "additionalProperties": false
    },
    "mode": {"enum": ["simulate", "apply"]},
    "candidateState": {"const": "generated-unchecked"},
    "registrationRequiredBeforeUse": {"const": true}
  }
}
