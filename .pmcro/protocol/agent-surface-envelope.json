{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PMCR-O activation envelope",
  "type": "object",
  "required": ["apiVersion", "kind", "traceId", "agentId", "mode", "scope", "grant", "limits"],
  "properties": {
    "apiVersion": {"const": "pmcro.dev/v1"},
    "kind": {"const": "ActivationEnvelope"},
    "traceId": {"type": "string", "minLength": 1},
    "agentId": {"type": "string", "minLength": 1},
    "mode": {"enum": ["inspect", "simulate", "replay", "execute", "check"]},
    "scope": {"enum": ["global", "personal", "project", "run"]},
    "grant": {"type": "object"},
    "limits": {"type": "object"}
  }
}
