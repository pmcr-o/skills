{
  "apiVersion": "pmcro.role-evals/v1",
  "pmcro-orchestrator": {
    "dimensions": [
      "intent-admission",
      "context-selection",
      "capability-resolution",
      "delegation-bounds",
      "planner-handoff",
      "high-level-goal-management",
      "cataloged-agent-selection"
    ],
    "mustNot": [
      "execute-maker-work",
      "widen-grant"
    ]
  },
  "pmcro-planner": {
    "dimensions": [
      "minimal-plan",
      "dependency-graph",
      "capability-gaps",
      "effect-bounds",
      "acceptance-criteria",
      "validated-capability-only",
      "minimum-capability-graph",
      "explicit-capability-gap"
    ],
    "mustNot": [
      "execute-plan",
      "invent-capability"
    ]
  },
  "pmcro-maker": {
    "dimensions": [
      "plan-fidelity",
      "admitted-capability-use",
      "evidence-completeness",
      "stop-on-gap",
      "skill-creator-gap-bootstrap",
      "candidate-state-discipline"
    ],
    "mustNot": [
      "self-certify",
      "silent-plan-expansion"
    ]
  },
  "pmcro-checker": {
    "dimensions": [
      "evidence-sufficiency",
      "contract-conformance",
      "verdict-classification",
      "adversarial-defect-detection",
      "no-repair",
      "candidate-state-gating",
      "registration-precondition-verification"
    ],
    "mustNot": [
      "repair-candidate",
      "check-own-maker-output"
    ],
    "independentFrom": [
      "pmcro-maker"
    ]
  },
  "pmcro-reflector": {
    "dimensions": [
      "exactly-one-next-seed",
      "valid-continuation-operation",
      "deduplication",
      "nonexecution",
      "fresh-cycle-boundary"
    ],
    "mustNot": [
      "execute-next-seed",
      "emit-multiple-next-seeds"
    ]
  }
}
