  "concepts": [
    {
      "id": "pmcro-canonical-authority",
      "classification": "ADOPT",
      "evidence": "A:/marketplace README/catalog declare .pmcro canonical; matches checked C: law."
    },
    {
      "id": "provider-projections",
      "classification": "ADOPT",
      "evidence": "A: host -> .agents -> .pmcro projection chain matches provider-projection law."
    },
    {
      "id": "generated-domain-agent-projects",
      "classification": "MERGE",
      "evidence": "A: eng/src and refresh/build tooling provide a mature generator model to reconcile with C: projection compiler."
    },
    {
      "id": "agent-registry-and-filesystem-queues",
      "classification": "MERGE",
      "evidence": "A: agent-registry.json binds local paths and filesystem-spool-v1 queues; richer than current C: registry."
    },
    {
      "id": "pinned-upstream-source",
      "classification": "ADOPT",
      "evidence": "A: eng/upstream uses pinned vendor source plus lock digest; compatible with provenance law."
    },
    {
      "id": "independent-marketplace-validation",
      "classification": "ADOPT",
      "evidence": "A: eng/validate-agent-repos.py is explicitly independent whole-marketplace validation."
    },
    {
      "id": "mandatory-all-skill-folders",
      "classification": "SUPERSEDE",
      "evidence": "A: eng/README requires scripts/references/assets/tests for every owned skill; current C: law requires only SKILL.md + agents/ and optional progressive layers."
    },
    {
      "id": "automatic-post-reflect-cycle",
      "classification": "SUPERSEDE",
      "evidence": "A: agent contracts automatically admit REFLECT next seed; checked C: next-seed law keeps it unexecuted until a fresh admitted Cycle."
    },
    {
      "id": "recursive-phase-cycles",
      "classification": "DEFER",
      "evidence": "A: contracts allow recursive lifecycle inside every bounded phase; current law only clearly admits explicit child delegation as a child Cycle."
    },
    {
      "id": "i-context-accountability-frame",
      "classification": "DEFER",
      "evidence": "A: pmcro.i-context/v1 appears useful but has no checked equivalent in current C: contracts yet."
    },
    {
      "id": "cross-agent-local-trails",
      "classification": "MERGE",
      "evidence": "A: each I owns a local trail and cross-I handoffs reference source trails; reconcile with current trail/evidence graph."
    },
    {
      "id": "transport-model-not-authority",
      "classification": "ADOPT",
      "evidence": "A: explicitly states transport/model identity never grants authority; matches checked C: law."
    },
    {
      "id": "maker-no-self-certification",
      "classification": "ADOPT",
      "evidence": "A: Maker output remains evidence until independent CHECK; matches current C: law."
    },
    {
      "id": "eng-history",
      "classification": "REFERENCE",
      "evidence": "A: eng/history is declared superseded provenance and must not drive new builds."
    }
  ],
