{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PMCR-O Clean Architecture request",
  "type": "object",
  "required": ["apiVersion", "kind", "requestId", "traceId", "applicationName", "rootNamespace", "targetFramework", "entities", "source", "target", "mode", "grant", "outputProfile"],
  "properties": {
    "apiVersion": {"const": "pmcro.dev/v1"},
    "kind": {"const": "CleanArchitectureRequest"},
    "applicationName": {"type": "string", "minLength": 1},
    "rootNamespace": {"type": "string", "minLength": 1},
    "targetFramework": {"type": "string", "pattern": "^net[0-9]+\\.[0-9]+$"},
    "entities": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$"}},
    "source": {"type": "object", "required": ["type", "ref"]},
    "target": {"type": "object", "required": ["root", "scope"]},
    "mode": {"enum": ["inspect", "simulate", "stage", "execute", "check"]}
  }
}
