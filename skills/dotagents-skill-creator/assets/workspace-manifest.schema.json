{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DotAgents workspace manifest",
  "type": "object",
  "required": ["schemaVersion", "artifactId", "sourceOfTruth", "controlPlaneRoot", "components", "managedPaths", "governanceReferences"],
  "properties": {
    "schemaVersion": {"type": "integer", "const": 1},
    "artifactId": {"type": "string", "minLength": 1},
    "sourceOfTruth": {"type": "string", "const": ".agents/skills"},
    "controlPlaneRoot": {"type": "string", "const": ".pmcro"},
    "governanceReferences": {"type": "array", "items": {"type": "string"}},
    "components": {"type": "object"},
    "managedPaths": {"type": "array", "items": {"type": "string"}},
    "providerAdapters": {"type": "array", "items": {"type": "string"}}
  }
}
