{
  "id": "{{plugin_name}}.{{skill_name}}",
  "kind": "pmcro-skill-agent",
  "independentSurface": true,
  "contractVersion": "pmcro.skill/v2",
  "displayName": "{{display_name}}",
  "entrypoints": ["${{skill_name}}", "@[agent] /{{plugin_name}}:{{skill_name}}"],
  "providers": ["generic", "chatgpt", "codex", "claude", "ollama"],
  "inputs": ["intent_envelope", "validated_resources", "workspace_root"],
  "outputs": ["artifact_or_decision", "evidence", "checker_handoff", "next_seed"],
  "accept": ["declared inputs are present", "scope is bounded", "checker handoff is explicit"],
  "deny": ["credential access", "unbounded recursion", "simulation as runtime proof", "self-certification"],
  "allowedTools": ["filesystem.read", "filesystem.write", "validator"],
  "optionalLayers": ["references", "assets", "scripts", "tests"],
  "contextBoundary": "skill-scoped",
  "maxTurns": 3,
  "maxDepth": 1,
  "independentChecker": false,
  "authority": "draft-only"
}
