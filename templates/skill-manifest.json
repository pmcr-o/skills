{
  "name": "example-skill",
  "displayName": "Example declarative skill",
  "version": "0.1.0",
  "defaultAuthoringSurface": "skill-creator",
  "defaultOutputContract": "templates/skill-output-envelope.json",
  "outputProfiles": ["json", "dotnet-console", "trail"],
  "entrypoints": ["@[agent] /[plugin]:[skill]"],
  "requiredFolders": ["agents", "scripts", "references", "assets", "tests"],
  "requiredFiles": ["SKILL.md", "agents/openai.yaml", "scripts/validate.ps1", "references/sample-prompts.md", "assets/README.md", "tests/README.md"],
  "requiredFilePatterns": ["agents/*.json"],
  "authoringGate": {
    "entrypoint": "@skill-creator /create-skill",
    "messageKind": "skill.create.request",
    "requiredBeforePhases": ["plan", "make"],
    "marketplaceRegistration": "after-independent-checker"
  },
  "exampleDocumentation": {
    "requiredFile": "assets/README.md",
    "requiredSections": ["Purpose", "Inputs", "Expected output", "Evidence and limits"]
  },
  "samplePrompts": {
    "requiredFile": "references/sample-prompts.md",
    "maxPrompts": 5,
    "maxCharactersPerPrompt": 600,
    "format": "markdown-copy-paste"
  },
  "limits": {
    "maxDiscoveryCycles": 3,
    "maxTurnsPerCycle": 8,
    "maxChildDepth": 2,
    "promotion": "checker-verified-only"
  },
  "sideEffects": "staged-until-human-or-policy-approval",
  "handoff": ["intent", "scope", "artifacts", "evidence", "open_findings", "next_seed"],
  "contractVersion": "pmcro.skill/v1",
  "messageContract": {
    "input": ["source reference", "owner/consent", "scope", "validated resources", "skill.create.request"],
    "output": ["artifacts", "evidence", "simulation status", "next seed"],
    "accept": ["declared acceptance evidence passes", "independent checker is present"],
    "deny": ["credentials", "unverified runtime claims", "automatic promotion", "unbounded recursion"]
  }
}
